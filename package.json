{
  "name": "coinlark",
  "private": true,
  "version": "1.0.0",
  "description": "Multi-currency money app built as a portfolio piece for fintech frontend roles. All data synthetic and seeded.",
  "type": "module",
  "license": "MIT",
  "author": "Pablo Williams",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --port 5190 --strictPort",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 5191 --strictPort",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "bench": "tsx bench/run-all.ts",
    "bench:feed": "playwright test -c playwright.perf.config.ts",
    "bundle": "tsx scripts/bundle-size.ts",
    "screenshots": "tsx scripts/screenshots.ts",
    "evidence": "tsx scripts/evidence.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@playwright/test": "1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.3",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fast-check": "^4.10.2",
    "globals": "^17.12.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.1",
    "vitest": "^5.0.2",
    "yaml": "^2.9.1"
  }
}
